# ============================================================
# AL MURTHAQA QURAN ACADEMY - ENVIRONMENT CONFIGURATION
# ============================================================

# 1. Razorpay Public Key ID
# Get this from: Razorpay Dashboard -> Account & Settings -> API Keys
# For Live payments, this starts with "rzp_live_"
# For Test payments, this starts with "rzp_test_"
VITE_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE

# ------------------------------------------------------------
# CRITICAL SECURITY NOTE ON RAZORPAY KEY SECRET:
# DO NOT put your Razorpay Key Secret here!
# In Vite/React, any variable prefixed with VITE_ is bundled into
# the client-side code and visible to anyone inspecting the page.
# Razorpay Standard Checkout only requires the public Key ID in the
# browser. Your Key Secret must remain strictly private.
# ------------------------------------------------------------

# 2. Google Apps Script Web App URL (Optional override)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwMXDVBiOm9P2knIguuPDfV1hjrZmGnxKQ6ETnMe_aBnxF1JOXF9dwSr3d7Vw6f7SOIsQ/exec

# 3. Admin WhatsApp number (10 digits without +91)
VITE_ADMIN_PHONE=7736844171

